{
  "name": "@aptx-js/frontend-tk-binding",
  "version": "0.1.20",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "ghRelease": false,
    "binaryName": "frontend-tk-binding",
    "targets": [
      "aarch64-apple-darwin",
      "aarch64-unknown-linux-musl",
      "aarch64-pc-windows-msvc",
      "armv7-unknown-linux-gnueabihf",
      "armv7-unknown-linux-musleabihf",
      "x86_64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl"
    ]
  },  "repository": {
    "type": "git",
    "url": "git+https://github.com/HaibaraAiAPTX/frontend_tk_rs.git",
    "directory": "crates/node_binding"
  },

  "license": "MIT",
  "devDependencies": {
    "@napi-rs/cli": "^3.5.1",
    "ava": "^6.0.1"
  },
  "ava": {
    "timeout": "3m"
  },
  "engines": {
    "node": ">= 10"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test": "ava",
    "universal": "napi universal",
    "version": "napi version"
  }
}
